# Web3Forms access key: orders and contact messages are emailed to hello@plantqi.com.
# Get one free at https://web3forms.com and add it in Vercel → Project → Settings → Environment Variables.
VITE_WEB3FORMS_KEY=

# Optional alternative backend: a Google Apps Script web app URL (ends in /exec).
# Set VITE_FORM_BACKEND=sheet to use it instead of email.
VITE_FORM_BACKEND=email
VITE_SHEET_URL=
